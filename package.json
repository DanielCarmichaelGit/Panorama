{
  "name": "boomerang",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "vitest run",
    "dev:server": "pnpm --filter @boomerang/server dev",
    "dev:web": "pnpm --filter @boomerang/web dev",
    "build:web": "pnpm --filter @boomerang/web build",
    "start": "pnpm build:web && pnpm --filter @boomerang/server start",
    "e2e": "playwright test",
    "demo:agent": "tsx scripts/demo-agent.ts",
    "provenance": "node scripts/provenance/cli.mjs",
    "test:provenance": "node --test scripts/provenance/*.test.mjs"
  },
  "dependencies": { "@boomerang/core": "workspace:*" },
  "devDependencies": { "typescript": "^5.5.0", "vitest": "^2.1.0", "tsx": "^4.19.0", "@types/node": "^20.14.0", "@playwright/test": "^1.63.0" },
  "pnpm": { "onlyBuiltDependencies": ["better-sqlite3-multiple-ciphers", "esbuild"] }
}
